{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "world.schema.json",
  "title": "Adventure world",
  "description": "A world file for the AirplaneMode adventure engine. See docs/writing-a-game.md. The engine's validate() and the solver check what a schema can't (ids that must exist, reachability).",
  "type": "object",
  "required": ["title", "intro", "start", "map", "rooms", "items", "uses", "endings", "verb_defaults"],
  "additionalProperties": false,
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "word": { "type": "string", "pattern": "^[a-z]+$" },
    "condition": { "type": "string", "pattern": "^(has|flag|seen):[a-z0-9_]+(\\|(has|flag|seen):[a-z0-9_]+)*$",
      "description": "has:item, flag:name or seen:room; join with | for 'or'" },
    "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "direction": { "enum": ["north", "south", "east", "west", "up", "down"] },
    "endingRef": { "oneOf": [
      { "$ref": "#/definitions/id" },
      { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["ending"], "additionalProperties": false,
        "properties": { "if": { "$ref": "#/definitions/condition" }, "ending": { "$ref": "#/definitions/id" } } } }
    ], "description": "An ending id, or a list of {if, ending}; the last option has no 'if'" },
    "factRef": { "oneOf": [
      { "type": "string" },
      { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["fact"], "additionalProperties": false,
        "properties": { "if": { "$ref": "#/definitions/condition" }, "fact": { "type": "string" } } } }
    ] },
    "costRef": { "oneOf": [
      { "type": "integer", "minimum": 0 },
      { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["cost"], "additionalProperties": false,
        "properties": { "if": { "$ref": "#/definitions/condition" }, "cost": { "type": "integer", "minimum": 0 } } } }
    ] }
  },
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "blurb": { "type": "string", "description": "One line for the adventure picker" },
    "setting": { "type": "string", "description": "A few words the narrator prompt uses, e.g. 'a lighthouse during a storm'" },
    "intro": { "type": "string" },
    "start": { "$ref": "#/definitions/id" },
    "theme": { "type": "object", "additionalProperties": false,
      "properties": { "accent": { "$ref": "#/definitions/colour" }, "beat": { "$ref": "#/definitions/colour" } } },
    "ui": { "type": "object", "additionalProperties": false, "properties": {
      "clock_title": { "type": "string" },
      "clock_labels": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2,
        "items": [{ "type": "integer" }, { "type": "string" }] },
        "description": "[[turns_left_above, label], ...] highest first; the last should be [0, ...]" },
      "over_label": { "type": "string" },
      "map_label": { "type": "string" },
      "ambience": { "enum": ["storm", "wind", "none"], "description": "Background sound the page can play" } } },
    "verb_defaults": { "type": "object", "required": ["light", "unlock", "fill"], "additionalProperties": false,
      "properties": { "light": { "$ref": "#/definitions/id" }, "unlock": { "$ref": "#/definitions/id" }, "fill": { "$ref": "#/definitions/id" } } },
    "tool_missing": { "type": "object", "additionalProperties": false,
      "properties": { "light": { "type": "string" }, "unlock": { "type": "string" }, "fill": { "type": "string" } } },
    "verbs": { "type": "object", "description": "The world's own verbs: {verb: [synonyms]}",
      "propertyNames": { "pattern": "^[a-z]+$" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/word" } } },
    "map": { "type": "object", "additionalProperties": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } } },
    "rooms": { "type": "object", "additionalProperties": {
      "type": "object", "required": ["name", "desc", "exits", "items"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "desc": { "type": "string" },
        "dark": { "type": "boolean" },
        "dark_desc": { "type": "string" },
        "exits": { "type": "object", "propertyNames": { "$ref": "#/definitions/direction" }, "additionalProperties": {
          "oneOf": [ { "$ref": "#/definitions/id" },
            { "type": "object", "required": ["to", "flag", "blocked"], "additionalProperties": false,
              "properties": { "to": { "$ref": "#/definitions/id" }, "flag": { "type": "string" }, "blocked": { "type": "string" } } } ] } },
        "items": { "type": "array", "items": { "$ref": "#/definitions/id" } } } } },
    "items": { "type": "object", "additionalProperties": {
      "type": "object", "required": ["name", "aliases", "desc"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]+( [a-z]+)*$" } },
        "desc": { "type": "string" },
        "portable": { "type": "boolean" },
        "person": { "type": "boolean" },
        "container": { "type": "boolean" },
        "contains": { "type": "array", "items": { "$ref": "#/definitions/id" } },
        "desc_open": { "type": "string" },
        "open_fact": { "type": "string" },
        "locked_flag": { "type": "string" },
        "light_flag": { "type": "string" },
        "desc_flags": { "type": "object", "additionalProperties": { "type": "string" } },
        "talk": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["say"], "additionalProperties": false,
          "properties": { "if": { "$ref": "#/definitions/condition" }, "say": { "type": "string" }, "set": { "type": "string" },
            "reveal": { "type": "object", "additionalProperties": { "$ref": "#/definitions/id" } } } } } } } },
    "uses": { "type": "array", "items": { "type": "object", "required": ["item", "target", "fact"], "additionalProperties": false,
      "properties": {
        "item": { "$ref": "#/definitions/id" }, "target": { "$ref": "#/definitions/id" },
        "fact": { "$ref": "#/definitions/factRef" },
        "set": { "type": "string" }, "clear": { "type": "string" }, "renew": { "type": "string" },
        "requires": { "type": "string" }, "missing": { "type": "string" },
        "unless": { "type": "string" }, "already": { "type": "string" },
        "refuse": { "type": "array", "items": { "type": "object", "required": ["if", "say"], "additionalProperties": false,
          "properties": { "if": { "$ref": "#/definitions/condition" }, "say": { "type": "string" } } } },
        "where": { "$ref": "#/definitions/id" }, "wrong_place": { "type": "string" },
        "consume": { "type": "boolean" },
        "ending": { "$ref": "#/definitions/endingRef" } } } },
    "interactions": { "type": "array", "items": { "type": "object", "required": ["verb", "target", "fact"], "additionalProperties": false,
      "properties": {
        "verb": { "$ref": "#/definitions/word" }, "target": { "$ref": "#/definitions/id" },
        "fact": { "$ref": "#/definitions/factRef" },
        "set": { "type": "string" }, "unless": { "type": "string" }, "already": { "type": "string" },
        "cost": { "$ref": "#/definitions/costRef" },
        "move": { "type": "object", "additionalProperties": { "$ref": "#/definitions/id" } },
        "move_player": { "$ref": "#/definitions/id" },
        "requires": { "type": "string" }, "missing": { "type": "string" },
        "ending": { "$ref": "#/definitions/endingRef" } } } },
    "timers": { "type": "object", "additionalProperties": { "type": "object", "required": ["turns", "out_fact"], "additionalProperties": false,
      "properties": { "turns": { "type": "integer", "minimum": 1 }, "warn": { "type": "integer", "minimum": 0 },
        "warn_fact": { "type": "string" }, "out_fact": { "type": "string" }, "then": { "type": "string" } } } },
    "variants": { "type": "array", "items": { "type": "object", "required": ["id", "item", "options"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/definitions/id" }, "item": { "$ref": "#/definitions/id" },
        "options": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["at"], "additionalProperties": false,
          "properties": { "at": { "$ref": "#/definitions/id" }, "text": { "type": "string" } } } } } } },
    "modes": { "type": "object", "additionalProperties": false, "patternProperties": {
      "^(relaxed|normal|hard)$": { "type": "object", "additionalProperties": false, "properties": {
        "deadline": { "type": "number", "exclusiveMinimum": 0 }, "timers": { "type": "boolean" },
        "hints": { "type": "boolean" }, "label": { "type": "string" } } } } },
    "clock": { "type": "object", "required": ["deadline", "deadline_ending", "beats"], "additionalProperties": false,
      "properties": { "deadline": { "type": "integer", "minimum": 1 }, "deadline_ending": { "$ref": "#/definitions/id" },
        "beats": { "type": "array", "items": { "type": "object", "required": ["turn", "fact"], "additionalProperties": false,
          "properties": { "turn": { "type": "integer", "minimum": 1 }, "fact": { "type": "string" } } } } } },
    "endings": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "required": ["title", "tone", "text"], "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "text": { "type": "string" }, "hint": { "type": "string" },
        "tone": { "enum": ["best", "good", "bittersweet", "mixed", "dark", "worst"] } } } },
    "hints": { "type": "array", "items": { "type": "object", "required": ["done", "hint"], "additionalProperties": false,
      "properties": { "done": { "$ref": "#/definitions/condition" }, "hint": { "type": "string" } } } }
  }
}
